# Copy to .env and fill in values. Never commit .env.

OPENAI_API_KEY=

# Server port (optional; default 5006)
PORT=5008

# Optional: Twilio WhatsApp (grocery agent)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_WHATSAPP=whatsapp:+14155238886

# Optional but recommended: Firestore Admin (for grocery persistence in cloud).
# If omitted, server falls back to local JSON files under server/data/.
